{
  "version": 1,
  "purpose": "Claude-authored Parallax presentation replacement with mixed integration reserved for trusted Codex review",
  "requiredBranchPrefix": "claude-ui/",
  "requiredBaseRef": "origin/main",
  "requireNoOutOfScopeChanges": true,
  "allowCreate": false,
  "writableFiles": [
    "styles/design-system/components.css",
    "styles/design-system/styles.css",
    "styles/design-system/tokens/fonts.css",
    "styles/design-system/tokens/graphite-aubergine.css",
    "styles/design-system/tokens/scale.css",
    "styles/design-system/tokens/type.css",
    "styles/goals.css",
    "styles/header.css",
    "styles/household.css",
    "styles/main.css",
    "styles/parallax-layout.css",
    "styles/scenarios.css",
    "styles/sequencing.css",
    "styles/tax-aware-withdrawal.css",
    "styles/tax-buckets.css"
  ],
  "creatableFiles": [],
  "allowedCommands": [
    "git rev-parse --show-toplevel",
    "git branch --show-current",
    "git rev-parse HEAD",
    "git rev-parse origin/main",
    "git remote -v",
    "git rev-list --left-right --count origin/main...HEAD",
    "git --no-optional-locks status --short --branch",
    "git --no-pager diff --no-ext-diff --no-textconv",
    "git --no-pager diff --no-ext-diff --no-textconv --stat",
    "git --no-pager diff --no-ext-diff --no-textconv --name-only",
    "git --no-pager diff --no-ext-diff --no-textconv --check"
  ],
  "protectedPaths": [
    ".claude/**",
    ".git/**",
    ".github/**",
    ".gitignore",
    ".worktrees/**",
    "AGENTS.md",
    "CLAUDE.md",
    "PRINCIPLES.md",
    "README.md",
    "assets/**",
    "docs/**",
    "engine.js",
    "engine.test.js",
    "index.html",
    "package.json",
    "package-lock.json",
    "scripts/**",
    "src/main.js",
    "src/household/**",
    "src/planning/**",
    "src/scenarios/**",
    "src/state.js",
    "src/tax/**",
    "test/**",
    "tests/**",
    "ui/*.test.js",
    "ui/birthDateField.js",
    "ui/cashflow.js",
    "ui/chartLayout.js",
    "ui/charts.js",
    "ui/designSystemPrimitives.js",
    "ui/dom.js",
    "ui/formatters.js",
    "ui/goalsHorizon.js",
    "ui/household.js",
    "ui/householdFactories.js",
    "ui/householdIncomeTax.js",
    "ui/householdSpendingGoals.js",
    "ui/householdTaxFacts.js",
    "ui/householdWizard.js",
    "ui/householdWizardFamily.js",
    "ui/householdWizardNetWorth.js",
    "ui/householdWizardSummary.js",
    "ui/householdWizardTax.js",
    "ui/scenarios.js",
    "ui/sequencing.js",
    "ui/solver.js",
    "ui/taxAwareWithdrawal.js",
    "ui/taxAwareWithdrawalColumns.js",
    "ui/taxAwareWithdrawalDom.js",
    "ui/taxBuckets.js"
  ]
}
