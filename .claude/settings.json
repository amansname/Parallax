{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0"
  },
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(/styles/design-system/components.css)",
      "Edit(/styles/design-system/styles.css)",
      "Edit(/styles/design-system/tokens/fonts.css)",
      "Edit(/styles/design-system/tokens/graphite-aubergine.css)",
      "Edit(/styles/design-system/tokens/scale.css)",
      "Edit(/styles/design-system/tokens/type.css)",
      "Edit(/styles/goals.css)",
      "Edit(/styles/header.css)",
      "Edit(/styles/household.css)",
      "Edit(/styles/main.css)",
      "Edit(/styles/parallax-layout.css)",
      "Edit(/styles/scenarios.css)",
      "Edit(/styles/sequencing.css)",
      "Edit(/styles/tax-aware-withdrawal.css)",
      "Edit(/styles/tax-buckets.css)",
      "Bash(git rev-parse --show-toplevel)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse HEAD)",
      "Bash(git rev-parse origin/main)",
      "Bash(git remote -v)",
      "Bash(git rev-list --left-right --count origin/main...HEAD)",
      "Bash(git --no-optional-locks status --short --branch)",
      "Bash(git --no-pager diff --no-ext-diff --no-textconv)",
      "Bash(git --no-pager diff --no-ext-diff --no-textconv --stat)",
      "Bash(git --no-pager diff --no-ext-diff --no-textconv --name-only)",
      "Bash(git --no-pager diff --no-ext-diff --no-textconv --check)"
    ],
    "deny": [
      "Write",
      "NotebookEdit",
      "Edit(/engine.js)",
      "Edit(/engine.test.js)",
      "Edit(/index.html)",
      "Edit(/src/main.js)",
      "Edit(/src/state.js)",
      "Edit(/src/tax/**)",
      "Edit(/src/planning/**)",
      "Edit(/src/household/**)",
      "Edit(/src/scenarios/**)",
      "Edit(/ui/*.test.js)",
      "Edit(/ui/birthDateField.js)",
      "Edit(/ui/cashflow.js)",
      "Edit(/ui/chartLayout.js)",
      "Edit(/ui/charts.js)",
      "Edit(/ui/designSystemPrimitives.js)",
      "Edit(/ui/goalsHorizon.js)",
      "Edit(/ui/householdFactories.js)",
      "Edit(/ui/householdFactories.test.js)",
      "Edit(/ui/household.js)",
      "Edit(/ui/householdIncomeTax.js)",
      "Edit(/ui/householdSpendingGoals.js)",
      "Edit(/ui/householdTaxFacts.js)",
      "Edit(/ui/householdWizard.js)",
      "Edit(/ui/householdWizardFamily.js)",
      "Edit(/ui/householdWizardNetWorth.js)",
      "Edit(/ui/householdWizardSummary.js)",
      "Edit(/ui/householdWizardTax.js)",
      "Edit(/ui/scenarios.js)",
      "Edit(/ui/sequencing.js)",
      "Edit(/ui/solver.js)",
      "Edit(/ui/formatters.js)",
      "Edit(/ui/dom.js)",
      "Edit(/ui/taxAwareWithdrawal.js)",
      "Edit(/ui/taxAwareWithdrawalColumns.js)",
      "Edit(/ui/taxAwareWithdrawalDom.js)",
      "Edit(/ui/taxBuckets.js)",
      "Edit(/scripts/**)",
      "Edit(/test/**)",
      "Edit(/tests/**)",
      "Edit(/docs/**)",
      "Edit(/assets/**)",
      "Edit(/styles/design-system/assets/**)",
      "Edit(/package.json)",
      "Edit(/package-lock.json)",
      "Edit(/.github/**)",
      "Edit(/.vscode/**)",
      "Edit(/.gitignore)",
      "Edit(/README.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/CLAUDE.local.md)",
      "Edit(/AGENTS.md)",
      "Edit(/PRINCIPLES.md)",
      "Edit(/.claude/**)",
      "Edit(/.git)",
      "Edit(/.git/**)",
      "Edit(/.worktrees/**)",
      "Bash(git add *)",
      "Bash(git am *)",
      "Bash(git apply *)",
      "Bash(git checkout *)",
      "Bash(git cherry-pick *)",
      "Bash(git clean *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git merge *)",
      "Bash(git mv *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git revert *)",
      "Bash(git rm *)",
      "Bash(git stash *)",
      "Bash(git switch *)",
      "Bash(git tag *)",
      "Bash(git worktree *)",
      "Bash(gh *)",
      "Bash(node *)",
      "Bash(py *)",
      "Bash(python *)",
      "Bash(cmd *)",
      "Bash(sh *)",
      "Bash(bun *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(npm ci *)",
      "Bash(npm install *)",
      "Bash(npm publish *)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx *)",
      "PowerShell",
      "Agent",
      "Task",
      "EnterWorktree",
      "WebFetch",
      "WebSearch",
      "mcp__*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-ui-scope.mjs"
            ]
          }
        ]
      }
    ]
  }
}
