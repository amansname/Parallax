    "pretest": "node --test src/tax/federal/rules/enhancedSeniorDeduction.test.js src/tax/federal/rules/medicalExpenseDeduction.test.js src/tax/federal/rules/saltDeductionCap.test.js src/tax/federal/rules/overallItemizedDeductionLimit.test.js",
    "test": "node scripts/run-unit-tests.mjs",
    "verify": "node scripts/verify.mjs",
    "tax:smoke": "node scripts/tax-smoke.mjs",
    "tax:intake": "node scripts/tax-intake.mjs",
    "tax:engine-year": "node scripts/tax-engine-year.mjs",
    "preview": "node scripts/preview.mjs",
    "site:build": "node scripts/build-site-artifact.mjs",
    "site:verify": "node scripts/verify-site-artifact.mjs",
    "site:verify-live": "node scripts/verify-live-site.mjs",
    "test:inventory": "node scripts/run-unit-tests.mjs --list"
